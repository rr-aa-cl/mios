# Settings for the nuc3 Kubernetes deployment. kustomization.yaml turns this
# file into the mios-runtime-config ConfigMap, which every container receives
# as environment variables. A change here replaces the Pod.

# Robot
ROBOT_IP=192.168.3.100
ROS_DOMAIN_ID=0
MIOS_LOAD_GRIPPER=true

# CPUs. nuc3 has CPUs 0-15; the reported SMT siblings are 6 and 14. That
# physical core is reserved for the controller and the Franka NIC IRQs.
# MIOS_CONTROL_RT_CPU must match cpu_affinity in mios_controllers.yaml.
MIOS_CONTROL_WORKER_CPUS=0-5,7-13,15
MIOS_CONTROL_RT_CPU=6
MIOS_NONRT_CPUS=0-5,7-13,15

# Control start-up: raise the real-time limits and hold the node's FCI lock.
MIOS_REQUIRE_RT_LIMITS=true
MIOS_FCI_LOCK_FILE=/var/lock/mios-fr3/fci.lock

# Core and MLS wait this long for MongoDB (and MLS for the Core Portal).
MIOS_STARTUP_WAIT_SECONDS=180

# Database
MONGO_DB_NAME=mios
MONGO_PORT=27017
ROBOT_CONFIG=0

# Ports. When changing these, also update the container and Service ports in
# runtime.yml.
MIOS_WS_PORT=12000
MIOS_RPC_PORT=12001
MIOS_UDP_PORT=12002
MIOS_ML_PORT=8000

# Core behaviour
MIOS_ENABLE_CORE_SCHEDULER=true
MIOS_ENABLE_CORE_TASK_EXECUTION=true
MIOS_ALLOW_CONTROLLER_OWNED_MOVE_MODE=true
MIOS_ENABLE_JOINT_VELOCITY_CONTROL=true
